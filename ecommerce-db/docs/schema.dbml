// Схема БД: електронна комерція з кількома магазинами
// Вставити на https://dbdiagram.io/d (Import -> DBML або в редактор).
// Позначки: [soft delete] = is_deleted/deleted_at/deleted_by, [audit] = updated_at/updated_by

Enum discount_type {
  percent
  fixed
}

Enum inventory_reason {
  restock
  sale
  cancellation
  adjustment
  return
}

Enum order_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

Enum payment_method {
  card
  cash_on_delivery
  bank_transfer
  paypal
}

Enum payment_status {
  pending
  completed
  failed
  refunded
}

Enum shipment_status {
  preparing
  in_transit
  delivered
  returned
}

Table addresses {
  id bigint [pk, increment]
  user_id bigint [not null]
  label varchar(50) [not null, default: `'Дім'`]
  country varchar(80) [not null]
  city varchar(100) [not null]
  street_line varchar(255) [not null]
  postal_code varchar(20)
  is_default boolean [not null, default: `false`]
  created_at timestamptz [not null, default: `now()`]
}

Table audit_log {
  id bigint [pk, increment]
  table_name text [not null]
  record_id bigint [not null]
  action text [not null]
  old_data jsonb
  new_data jsonb
  changed_by bigint
  changed_at timestamptz [not null, default: `now()`]
}

Table brands {
  id bigint [pk, increment]
  name varchar(120) [not null]
  country varchar(80)
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null]
  store_product_id bigint [not null]
  quantity integer [not null]
  added_at timestamptz [not null, default: `now()`]
}

Table carts {
  id bigint [pk, increment]
  user_id bigint [not null]
  store_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'audit: updated_at/updated_by'
}

Table categories {
  id bigint [pk, increment]
  parent_id bigint
  name varchar(120) [not null]
  slug varchar(120) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table coupons {
  id bigint [pk, increment]
  store_id bigint
  code varchar(50) [not null]
  discount_type discount_type [not null]
  discount_value numeric(12,2) [not null]
  min_order_amount numeric(12,2) [not null, default: `0`]
  max_uses integer
  used_count integer [not null, default: `0`]
  valid_from timestamptz [not null, default: `now()`]
  valid_to timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table inventory_movements {
  id bigint [pk, increment]
  store_product_id bigint [not null]
  quantity_change integer [not null]
  reason inventory_reason [not null]
  order_id bigint
  created_at timestamptz [not null, default: `now()`]
  created_by bigint
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  store_product_id bigint [not null]
  product_name varchar(255) [not null]
  unit_price numeric(12,2) [not null]
  quantity integer [not null]
  line_total numeric(12,2) [note: 'generated']
}

Table order_status_history {
  id bigint [pk, increment]
  order_id bigint [not null]
  old_status order_status
  new_status order_status [not null]
  changed_at timestamptz [not null, default: `now()`]
  changed_by bigint
}

Table orders {
  id bigint [pk, increment]
  order_number varchar(30) [not null]
  user_id bigint [not null]
  store_id bigint [not null]
  shipping_address_id bigint [not null]
  shipping_method_id bigint [not null]
  coupon_id bigint
  status order_status [not null, default: `'pending'`]
  subtotal numeric(12,2) [not null, default: `0`]
  discount_amount numeric(12,2) [not null, default: `0`]
  shipping_cost numeric(12,2) [not null, default: `0`]
  total_amount numeric(12,2) [not null, default: `0`]
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint

  Note: 'audit: updated_at/updated_by'
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [not null]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  status payment_status [not null, default: `'pending'`]
  transaction_ref varchar(100)
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table products {
  id bigint [pk, increment]
  category_id bigint [not null]
  brand_id bigint
  sku varchar(64) [not null]
  name varchar(255) [not null]
  description text
  attributes jsonb [not null, default: `'{}'`]
  search_vector tsvector [note: 'generated']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table reviews {
  id bigint [pk, increment]
  product_id bigint [not null]
  user_id bigint [not null]
  rating smallint [not null]
  title varchar(150)
  body text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table roles {
  id smallint [pk, increment]
  name varchar(50) [not null]
  description text
}

Table shipments {
  id bigint [pk, increment]
  order_id bigint [not null]
  carrier varchar(100) [not null]
  tracking_number varchar(100)
  status shipment_status [not null, default: `'preparing'`]
  shipped_at timestamptz
  delivered_at timestamptz
}

Table shipping_methods {
  id bigint [pk, increment]
  store_id bigint [not null]
  name varchar(100) [not null]
  base_cost numeric(12,2) [not null]
  estimated_days integer [not null, default: `3`]
  is_active boolean [not null, default: `true`]
}

Table store_products {
  id bigint [pk, increment]
  store_id bigint [not null]
  product_id bigint [not null]
  price numeric(12,2) [not null]
  stock_qty integer [not null, default: `0`]
  is_listed boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table store_staff {
  store_id bigint [pk]
  user_id bigint [pk]
  position varchar(50) [not null, default: `'manager'`]
  hired_at timestamptz [not null, default: `now()`]
}

Table stores {
  id bigint [pk, increment]
  owner_id bigint [not null]
  name varchar(150) [not null]
  slug varchar(100) [not null]
  description text
  contact_email varchar(255)
  currency char(3) [not null, default: `'UAH'`]
  is_active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Table user_roles {
  user_id bigint [pk]
  role_id smallint [pk]
  assigned_at timestamptz [not null, default: `now()`]
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by bigint
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by bigint

  Note: 'soft delete; audit: updated_at/updated_by'
}

Ref: addresses.user_id > users.id
Ref: cart_items.cart_id > carts.id
Ref: cart_items.store_product_id > store_products.id
Ref: carts.store_id > stores.id
Ref: carts.user_id > users.id
Ref: categories.deleted_by > users.id
Ref: categories.parent_id > categories.id
Ref: categories.updated_by > users.id
Ref: coupons.deleted_by > users.id
Ref: coupons.store_id > stores.id
Ref: coupons.updated_by > users.id
Ref: inventory_movements.created_by > users.id
Ref: inventory_movements.order_id > orders.id
Ref: inventory_movements.store_product_id > store_products.id
Ref: order_items.order_id > orders.id
Ref: order_items.store_product_id > store_products.id
Ref: order_status_history.changed_by > users.id
Ref: order_status_history.order_id > orders.id
Ref: orders.coupon_id > coupons.id
Ref: orders.shipping_address_id > addresses.id
Ref: orders.shipping_method_id > shipping_methods.id
Ref: orders.store_id > stores.id
Ref: orders.updated_by > users.id
Ref: orders.user_id > users.id
Ref: payments.order_id > orders.id
Ref: products.brand_id > brands.id
Ref: products.category_id > categories.id
Ref: products.deleted_by > users.id
Ref: products.updated_by > users.id
Ref: reviews.deleted_by > users.id
Ref: reviews.product_id > products.id
Ref: reviews.updated_by > users.id
Ref: reviews.user_id > users.id
Ref: shipments.order_id > orders.id
Ref: shipping_methods.store_id > stores.id
Ref: store_products.deleted_by > users.id
Ref: store_products.product_id > products.id
Ref: store_products.store_id > stores.id
Ref: store_products.updated_by > users.id
Ref: store_staff.store_id > stores.id
Ref: store_staff.user_id > users.id
Ref: stores.deleted_by > users.id
Ref: stores.owner_id > users.id
Ref: stores.updated_by > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.user_id > users.id
Ref: users.deleted_by > users.id
Ref: users.updated_by > users.id
